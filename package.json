{
  "name": "pinpoint-showcase",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host --port 4173",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "offline-check": "node scripts/offline-check.cjs",
    "phone-run": "node scripts/phone-run.cjs",
    "prebuild": "node scripts/copy-ort.cjs",
    "predev": "node scripts/copy-ort.cjs",
    "monitor-shots": "node scripts/monitor-shots.cjs",
    "report-scan": "node scripts/report-scan.cjs",
    "postbuild": "node scripts/postbuild.cjs",
    "rehearse": "bash scripts/rehearse.sh"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.8.1",
    "fflate": "^0.8.3",
    "jsqr": "^1.4.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "pngjs": "^7.0.0",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^2.1.9"
